---
const galleryItems = [
  { id: 1, src: '/images/ironhive_fitness1.jpg', cat: 'Facility',    title: 'Main Strength Zone',   alt: 'Spacious gym floor with lifting platforms' },
  { id: 2, src: '/images/ironhive_fitness2.jpg', cat: 'Equipment',   title: 'Precision Machines',    alt: 'Row of heavy duty machines' },
  { id: 3, src: '/images/ironhive_fitness3.jpg', cat: 'Accessories', title: 'Free Weights Arsenal',  alt: 'Rack of dumbbells and weights' },
  { id: 4, src: '/images/ironhive_fitness4.jpg', cat: 'Facility',    title: 'Performance Sector',    alt: 'Gym area focused on performance' },
  { id: 5, src: '/images/ironhive_fitness5.jpg', cat: 'Equipment',   title: 'Heavy Duty Racks',      alt: 'Squat racks and power cages' },
  { id: 6, src: '/images/ironhive_fitness6.jpg', cat: 'Facility',    title: 'Conditioning Area',     alt: 'Open space for functional training' },
  { id: 7, src: '/images/ironhive_fitness7.jpg', cat: 'Accessories', title: 'Functional Gear',       alt: 'Specialized training accessories' },
];

const filters = ['All', 'Facility', 'Equipment', 'Accessories'];
---

<section class="gallery-section section" id="gallery" aria-labelledby="gallery-heading">
  <div class="container">

    <!-- Section Header -->
    <div class="section-header fade-in">
      <span class="section-label">The Arsenal</span>
      <h2 id="gallery-heading" class="section-title">Inside The <span class="text-brand">Hive</span></h2>
      <p class="section-body">
        Step inside Ironhive and witness a world-class facility engineered for peak performance.
        Every corner, every machine, every square foot — built to push your limits.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="filter-row fade-in" role="group" aria-label="Filter gallery by category">
      {filters.map((f) => (
        <button
          class={`filter-btn${f === 'All' ? ' active' : ''}`}
          data-filter={f}
          aria-pressed={f === 'All' ? 'true' : 'false'}
          type="button"
        >
          {f}
        </button>
      ))}
    </div>

    <!-- Gallery Grid -->
    <div class="gallery-grid fade-in" id="gallery-grid" aria-label="Photo gallery">
      {galleryItems.map((item) => (
        <div
          class="gallery-item"
          data-category={item.cat}
          data-src={item.src}
          data-alt={item.alt}
          data-title={item.title}
          data-hidden="false"
          role="button"
          tabindex="0"
          aria-label={`Open ${item.title} in lightbox`}
        >
          <img
            src={item.src}
            alt={item.alt}
            loading="lazy"
            decoding="async"
          />
          <div class="gallery-overlay">
            <div class="gallery-item-cat">{item.cat}</div>
            <div class="gallery-item-title">{item.title}</div>
          </div>
          <div class="gallery-expand" aria-hidden="true">
            <!-- Expand / Fullscreen Icon -->
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
            </svg>
          </div>
        </div>
      ))}
    </div>

  </div><!-- /.container -->
</section>

<!-- ===================== LIGHTBOX ===================== -->
<div class="lightbox-overlay" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
  <div class="lightbox-content">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close image viewer" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
    <div class="lightbox-img-wrap">
      <img id="lightbox-img" src="" alt="" />
    </div>
    <div class="lightbox-meta">
      <div id="lightbox-cat" class="gallery-item-cat"></div>
      <div id="lightbox-title" class="gallery-item-title lightbox-item-title"></div>
    </div>
  </div>
</div>

<style>
  /* ─── Section ─────────────────────────────────────────── */
  .gallery-section {
    padding: var(--section-gap, 96px) 0;
    background: var(--color-bg);
  }

  /* ─── Header ──────────────────────────────────────────── */
  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(36px, 5vw, 56px);
  }
  .section-label {
    display: inline-block;
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand);
    font-weight: 700;
    border: 1px solid rgba(232, 180, 0, 0.35);
    padding: 5px 14px;
    border-radius: 100px;
    margin-bottom: 16px;
  }
  .section-title {
    font-family: var(--font-headline, 'Barlow Condensed', sans-serif);
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-text);
    line-height: 1.05;
    margin: 0 0 16px;
  }
  .section-body {
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    line-height: 1.75;
    color: var(--color-muted);
    margin: 0;
  }

  /* ─── Filter Row ──────────────────────────────────────── */
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .filter-btn {
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 9px 22px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    min-height: 44px;
    line-height: 1;
  }
  .filter-btn:hover {
    color: var(--color-text);
    border-color: rgba(232, 180, 0, 0.4);
  }
  .filter-btn.active {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #111111;
  }

  /* ─── Gallery Grid ────────────────────────────────────── */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  /* ─── Gallery Item ────────────────────────────────────── */
  .gallery-item {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 4/3;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    outline-offset: 3px;
  }
  .gallery-item:focus-visible {
    outline: 2px solid var(--color-brand);
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease, filter 0.4s ease;
    filter: brightness(0.75);
    display: block;
  }
  .gallery-item:hover img {
    transform: scale(1.08);
    filter: brightness(1);
  }

  /* ─── Overlay ─────────────────────────────────────────── */
  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 13, 13, 0.9) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
  }
  .gallery-item:hover .gallery-overlay { opacity: 1; }

  .gallery-item-cat {
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-brand);
    font-weight: 700;
    margin-bottom: 4px;
  }
  .gallery-item-title {
    font-family: var(--font-headline, 'Barlow Condensed', sans-serif);
    font-size: 1.1rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* ─── Expand Icon ─────────────────────────────────────── */
  .gallery-expand {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    background: rgba(13, 13, 13, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    opacity: 0;
    transition: opacity 0.2s ease;
    backdrop-filter: blur(4px);
  }
  .gallery-item:hover .gallery-expand { opacity: 1; }

  /* ─── Hidden items ────────────────────────────────────── */
  .gallery-item[data-hidden="true"] { display: none; }

  /* ─── Responsive ──────────────────────────────────────── */
  @media (max-width: 1023px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 599px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }

  /* ─── Lightbox ────────────────────────────────────────── */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: rgba(13, 13, 13, 0.95);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 4vw, 40px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .lightbox-overlay.open {
    opacity: 1;
    pointer-events: all;
  }
  .lightbox-content {
    position: relative;
    width: 100%;
    max-width: 900px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    transform: scale(0.94) translateY(20px);
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.7);
  }
  .lightbox-overlay.open .lightbox-content {
    transform: scale(1) translateY(0);
  }
  .lightbox-close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    width: 38px;
    height: 38px;
    background: rgba(13, 13, 13, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    backdrop-filter: blur(4px);
  }
  .lightbox-close:hover {
    background: var(--color-brand);
    color: #111111;
  }
  .lightbox-img-wrap {
    position: relative;
    aspect-ratio: 16/9;
    background: #0D0D0D;
  }
  .lightbox-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .lightbox-meta {
    padding: 16px 20px;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }
  .lightbox-item-title {
    font-size: 1.3rem;
  }

  /* ─── Fade-in animation ───────────────────────────────── */
  .fade-in {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .fade-in.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  // ── Intersection Observer for fade-ins ──────────────────
  const fadeEls = document.querySelectorAll('#gallery .fade-in');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  fadeEls.forEach((el) => observer.observe(el));

  // ── Filter ──────────────────────────────────────────────
  const filterBtns = document.querySelectorAll('.filter-btn');
  const galleryItems = document.querySelectorAll('.gallery-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Update active state and aria-pressed
      filterBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');

      const cat = btn.dataset.filter;

      galleryItems.forEach((item) => {
        const match = cat === 'All' || item.dataset.category === cat;
        item.dataset.hidden = match ? 'false' : 'true';
      });
    });
  });

  // ── Lightbox ────────────────────────────────────────────
  const lightbox  = document.getElementById('lightbox');
  const lbImg     = document.getElementById('lightbox-img');
  const lbTitle   = document.getElementById('lightbox-title');
  const lbCat     = document.getElementById('lightbox-cat');
  const lbClose   = document.getElementById('lightbox-close');

  function openLB(item) {
    lbImg.src           = item.dataset.src;
    lbImg.alt           = item.dataset.alt;
    lbTitle.textContent = item.dataset.title;
    lbCat.textContent   = item.dataset.category;
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
    lbClose.focus();
  }

  function closeLB() {
    lightbox.classList.remove('open');
    document.body.style.overflow = '';
  }

  galleryItems.forEach((item) => {
    // Click
    item.addEventListener('click', () => openLB(item));
    // Keyboard accessibility
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLB(item);
      }
    });
  });

  lbClose.addEventListener('click', closeLB);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLB();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox.classList.contains('open')) closeLB();
  });
</script>
