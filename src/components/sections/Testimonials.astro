---
const testimonials = [
  {
    name: 'James T.',
    role: 'Gomti Nagar Resident',
    quote:
      'Hands down the best gym in Gomti Nagar Lucknow. The equipment is top tier, and the community vibe is unmatched. Worth every rupee!',
    stars: 5,
  },
  {
    name: 'Sarah M.',
    role: 'Professional from Gomti Nagar',
    quote:
      "I've tried many fitness centers in Lucknow, but Ironhive stands out for its hygiene and expert trainers. Perfect for working professionals like me.",
    stars: 5,
  },
  {
    name: 'David K.',
    role: 'Transformation Client',
    quote:
      'Lost 15kg in 4 months. If you are looking for a gym near you in Lucknow that actually delivers results, Ironhive is the place to be.',
    stars: 5,
  },
];
---

<section class="testimonials-section" id="testimonials" aria-labelledby="testimonials-heading">
  <div class="container">
    <!-- Section header -->
    <div class="section-header" style="text-align: center; margin-bottom: clamp(32px, 5vw, 56px);">
      <p class="section-label">Reviews</p>
      <h2 id="testimonials-heading" class="section-title">
        Voices From <span class="text-brand">The Hive</span>
      </h2>
    </div>

    <!-- Cards grid -->
    <div class="testimonials-grid">
      {testimonials.map(t => (
        <article class="testimonial-card">
          <!-- Decorative quote mark -->
          <span class="testimonial-quote-mark" aria-hidden="true">"</span>

          <!-- Stars -->
          <div class="testimonial-stars" aria-label={`${t.stars} out of 5 stars`}>
            {Array.from({ length: t.stars }).map(() => (
              <svg
                class="testimonial-star"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            ))}
          </div>

          <!-- Quote text -->
          <blockquote class="testimonial-quote">
            <p>"{t.quote}"</p>
          </blockquote>

          <!-- Author -->
          <footer class="testimonial-author">
            <p class="testimonial-name">{t.name}</p>
            <p class="testimonial-role">{t.role}</p>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Section ── */
  .testimonials-section {
    padding: var(--section-gap) 0;
    background: var(--color-surface);
  }

  /* ── Grid ── */
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
  }

  /* ── Card ── */
  .testimonial-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: clamp(24px, 3vw, 36px);
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .testimonial-card:hover {
    border-color: var(--color-brand);
    transform: translateY(-4px);
  }

  /* ── Decorative big quote mark ── */
  .testimonial-quote-mark {
    position: absolute;
    top: -10px;
    right: 20px;
    font-family: var(--font-headline);
    font-size: 7rem;
    font-weight: 900;
    color: rgba(232, 180, 0, 0.04);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  /* ── Stars ── */
  .testimonial-stars {
    display: flex;
    gap: 3px;
    margin-bottom: 16px;
  }
  .testimonial-star {
    width: 16px;
    height: 16px;
    fill: var(--color-brand);
    color: var(--color-brand);
    flex-shrink: 0;
  }

  /* ── Quote text ── */
  .testimonial-quote {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--color-muted);
    font-style: italic;
    flex: 1;
    margin-bottom: 20px;
    margin-left: 0;
    margin-right: 0;
  }
  .testimonial-quote p {
    margin: 0;
  }

  /* ── Author footer ── */
  .testimonial-author {
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }
  .testimonial-name {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0;
  }
  .testimonial-role {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 2px;
    margin-bottom: 0;
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) {
    .testimonials-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 599px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
