---
const days = [
  {
    key: 'monday',
    label: 'Mon',
    classes: [
      { time: '06:00 AM', name: 'Wake Up Warrior', trainer: 'Sunil' },
      { time: '09:00 AM', name: 'HIIT Burn',        trainer: 'Punit' },
      { time: '05:00 PM', name: 'Power Hour',        trainer: 'Sunil' },
      { time: '07:00 PM', name: 'Yoga Flow',         trainer: 'Punit' },
    ],
  },
  {
    key: 'tuesday',
    label: 'Tue',
    classes: [
      { time: '06:00 AM', name: 'Strength Foundations', trainer: 'Sunil' },
      { time: '08:00 AM', name: 'Cardio Blast',          trainer: 'Punit' },
      { time: '06:00 PM', name: 'Cross-Training',         trainer: 'Sunil' },
    ],
  },
  {
    key: 'wednesday',
    label: 'Wed',
    classes: [
      { time: '06:00 AM', name: 'Wake Up Warrior',      trainer: 'Sunil' },
      { time: '12:00 PM', name: 'Lunch Crunch',          trainer: 'Punit' },
      { time: '07:00 PM', name: 'Mobility Masterclass',  trainer: 'Punit' },
    ],
  },
  {
    key: 'thursday',
    label: 'Thu',
    classes: [
      { time: '06:00 AM', name: 'Power Lift', trainer: 'Sunil' },
      { time: '09:00 AM', name: 'Abs & Core', trainer: 'Punit' },
      { time: '06:00 PM', name: 'Beast Mode', trainer: 'Sunil' },
    ],
  },
  {
    key: 'friday',
    label: 'Fri',
    classes: [
      { time: '06:00 AM', name: 'Endurance Run', trainer: 'Punit' },
      { time: '05:00 PM', name: 'Full Body',      trainer: 'Sunil' },
      { time: '07:00 PM', name: 'Recovery',       trainer: 'Punit' },
    ],
  },
  {
    key: 'saturday',
    label: 'Sat',
    classes: [
      { time: '07:00 AM', name: 'Weekend Warrior', trainer: 'Sunil' },
      { time: '09:00 AM', name: 'Community Lift',  trainer: 'Punit' },
    ],
  },
];
---

<section class="schedule-section" id="schedule" aria-labelledby="schedule-heading">
  <div class="container">
    <div class="section-header" style="text-align: center; margin-bottom: clamp(32px, 5vw, 56px);">
      <p class="section-label">Timetable</p>
      <h2 id="schedule-heading" class="section-title">Plan Your <span class="text-brand">Attack</span></h2>
    </div>

    <div class="schedule-wrapper">
      <!-- Tab Buttons -->
      <div class="schedule-tabs" role="tablist" aria-label="Weekly schedule days">
        {days.map((day, i) => (
          <button
            class:list={['schedule-tab', { active: i === 0 }]}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${day.key}`}
            id={`tab-${day.key}`}
            data-day={day.key}
          >
            {day.label}
          </button>
        ))}
      </div>

      <!-- Tab Panels -->
      {days.map((day, i) => (
        <div
          class:list={['schedule-panel', { active: i === 0 }]}
          id={`panel-${day.key}`}
          role="tabpanel"
          aria-labelledby={`tab-${day.key}`}
          hidden={i !== 0}
        >
          {day.classes.map(cls => (
            <div class="schedule-row">
              <span class="schedule-time">{cls.time}</span>
              <span class="schedule-class">{cls.name}</span>
              <div class="schedule-trainer-badge">
                <span class="schedule-trainer-label">Trainer</span>
                <span class="schedule-trainer-name">{cls.trainer}</span>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .schedule-section {
    padding: var(--section-gap) 0;
    background: var(--color-bg);
  }

  .schedule-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  /* ── Tabs strip ── */
  .schedule-tabs {
    display: flex;
    gap: 4px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 5px;
    margin-bottom: 24px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .schedule-tabs::-webkit-scrollbar {
    display: none;
  }

  /* ── Individual tab button ── */
  .schedule-tab {
    flex: 1;
    min-width: 56px;
    padding: 11px 8px;
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--color-muted);
    background: transparent;
    white-space: nowrap;
    text-align: center;
    border: none;
    font-weight: 700;
  }
  .schedule-tab:hover {
    background: var(--color-surface-2);
    color: var(--color-text);
  }
  .schedule-tab.active {
    background: var(--color-brand);
    color: #0D0D0D;
    font-weight: 700;
  }

  /* ── Panel ── */
  .schedule-panel {
    display: none;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-surface);
  }
  .schedule-panel.active {
    display: block;
  }

  /* ── Row ── */
  .schedule-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 28px;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.2s ease;
    gap: 16px;
  }
  .schedule-row:last-child {
    border-bottom: none;
  }
  .schedule-row:hover {
    background: var(--color-surface-2);
  }

  /* ── Time ── */
  .schedule-time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-brand);
    font-weight: 700;
    min-width: 90px;
    letter-spacing: 0.05em;
  }

  /* ── Class name ── */
  .schedule-class {
    font-family: var(--font-headline);
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-text);
    flex: 1;
    transition: color 0.2s;
  }
  .schedule-row:hover .schedule-class {
    color: var(--color-brand);
  }

  /* ── Trainer badge ── */
  .schedule-trainer-badge {
    text-align: right;
  }
  .schedule-trainer-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    display: block;
  }
  .schedule-trainer-name {
    font-family: var(--font-headline);
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-text);
  }

  /* ── Mobile ── */
  @media (max-width: 599px) {
    .schedule-row {
      padding: 16px 20px;
      flex-wrap: wrap;
    }
    .schedule-time {
      min-width: auto;
    }
  }
</style>

<script>
  const tabs   = document.querySelectorAll<HTMLButtonElement>('.schedule-tab');
  const panels = document.querySelectorAll<HTMLElement>('.schedule-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      panels.forEach(p => {
        p.classList.remove('active');
        p.hidden = true;
      });

      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const target = document.getElementById('panel-' + tab.dataset.day);
      if (target) {
        target.classList.add('active');
        target.hidden = false;
      }
    });
  });
</script>
