---
// Trainers.astro — Ironhive Fitness Gym
// Meet Your Coaches section with 2 trainer portrait cards

interface Social {
  label: string;
  href: string;
  icon: 'instagram' | 'twitter' | 'linkedin';
}

interface Trainer {
  id: string;
  name: string;
  role: string;
  image: string;
  socials: Social[];
}

const trainers: Trainer[] = [
  {
    id: 'sunil-kumar',
    name: 'Sunil Kumar',
    role: 'Head Coach / Bodybuilding',
    image: '/images/trainer/sunil_kumar.jpg',
    socials: [
      {
        label: 'Instagram',
        href: 'https://www.instagram.com/ironhivefitnessgym_/',
        icon: 'instagram',
      },
      {
        label: 'Twitter',
        href: '#',
        icon: 'twitter',
      },
    ],
  },
  {
    id: 'punit-awasthi',
    name: 'Punit Awasthi',
    role: 'Senior Trainer / Fitness',
    image: '/images/trainer/punit_awasti.jpg',
    socials: [
      {
        label: 'Instagram',
        href: 'https://www.instagram.com/ironhivefitnessgym_/',
        icon: 'instagram',
      },
      {
        label: 'LinkedIn',
        href: '#',
        icon: 'linkedin',
      },
    ],
  },
];

// SVG icon paths helper
const socialSVGs: Record<string, string> = {
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>`,
  twitter: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
};
---

<section class="trainers-section" id="trainers" aria-label="Meet Your Coaches">
  <div class="container">
    <!-- Section header -->
    <div class="section-header fade-in">
      <span class="section-label">The Architects</span>
      <h2 class="section-h2">
        Meet Your <span class="text-brand">Coaches</span>
      </h2>
      <p class="section-desc">
        Our coaches don't just train bodies — they build champions. With years of
        experience in bodybuilding, fitness, and performance coaching, they'll
        push you further than you thought possible.
      </p>
    </div>

    <!-- Trainers grid -->
    <div class="trainers-grid fade-in" role="list" aria-label="Trainer profiles">
      {
        trainers.map((trainer) => (
          <article
            class="trainer-card"
            role="listitem"
            id={`trainer-${trainer.id}`}
            aria-label={`${trainer.name}, ${trainer.role}`}
          >
            {/* Expanding accent bar */}
            <div class="trainer-accent-bar" aria-hidden="true" />

            {/* Portrait image */}
            <div class="trainer-portrait">
              <img
                src={trainer.image}
                alt={`${trainer.name} — ${trainer.role} at Ironhive Fitness Gym`}
                width="480"
                height="640"
                loading="lazy"
                decoding="async"
              />
              <div class="trainer-portrait-overlay" aria-hidden="true" />

              {/* Social icons — slide in on hover */}
              <div class="trainer-socials" aria-label={`${trainer.name}'s social profiles`}>
                {trainer.socials.map((social) => (
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-icon"
                    aria-label={`${trainer.name} on ${social.label}`}
                    set:html={socialSVGs[social.icon]}
                  />
                ))}
              </div>

              {/* Name + role overlay */}
              <div class="trainer-info">
                <div class="trainer-name">{trainer.name}</div>
                <div class="trainer-role">{trainer.role}</div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Bottom flourish -->
    <div class="trainers-cta fade-in">
      <p class="trainers-cta-text">
        Want to train under our coaches?
      </p>
      <a
        href="https://wa.me/918127171111?text=Hi%20Ironhive,%20I%27d%20like%20to%20know%20more%20about%20personal%20coaching."
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline trainers-cta-btn"
        aria-label="Contact us on WhatsApp for personal coaching"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        Book a Free Consultation
      </a>
    </div>
  </div>
</section>

<style>
  /* ── Layout ─────────────────────────────────── */
  .trainers-section {
    padding: var(--section-gap) 0;
    background: var(--color-surface);
  }

  /* ── Section header ───────────────────────────── */
  .section-header {
    text-align: center;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .section-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand);
    background: rgba(232, 180, 0, 0.08);
    border: 1px solid rgba(232, 180, 0, 0.2);
    border-radius: 100px;
    padding: 6px 16px;
    margin-bottom: 20px;
  }

  .section-h2 {
    font-family: var(--font-headline);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text);
    margin: 0 0 16px;
  }

  .section-desc {
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Trainers grid ────────────────────────────── */
  .trainers-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(20px, 3vw, 36px);
    max-width: 900px;
    margin: 0 auto;
  }

  /* ── Trainer card ─────────────────────────────── */
  .trainer-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .trainer-card:hover {
    border-color: var(--color-brand);
    box-shadow: 0 20px 60px rgba(232, 180, 0, 0.15);
  }

  /* Expanding accent bar */
  .trainer-accent-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s ease;
    z-index: 10;
  }

  .trainer-card:hover .trainer-accent-bar {
    transform: scaleX(1);
  }

  /* ── Portrait ─────────────────────────────────── */
  .trainer-portrait {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .trainer-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.5s ease;
    display: block;
  }

  .trainer-card:hover .trainer-portrait img {
    transform: scale(1.05);
  }

  .trainer-portrait-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(13, 13, 13, 0.92) 0%,
      rgba(13, 13, 13, 0.2) 50%,
      transparent 100%
    );
  }

  /* ── Social icons ─────────────────────────────── */
  .trainer-socials {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transform: translateX(60px);
    opacity: 0;
    transition: all 0.3s ease;
  }

  .trainer-card:hover .trainer-socials {
    transform: translateX(0);
    opacity: 1;
  }

  .social-icon {
    width: 38px;
    height: 38px;
    background: rgba(13, 13, 13, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    text-decoration: none;
    transition: all 0.2s ease;
    backdrop-filter: blur(8px);
  }

  .social-icon:hover {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: #0d0d0d;
  }

  /* ── Trainer name / role overlay ──────────────── */
  .trainer-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 28px;
    z-index: 5;
  }

  .trainer-name {
    font-family: var(--font-headline);
    font-size: 1.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 4px;
  }

  .trainer-role {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-brand);
    font-weight: 700;
  }

  /* ── Bottom CTA ───────────────────────────────── */
  .trainers-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: clamp(36px, 5vw, 56px);
  }

  .trainers-cta-text {
    font-size: 1rem;
    color: var(--color-muted);
  }

  .trainers-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 8px;
    font-family: var(--font-headline);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: transparent;
    transition: all 0.2s ease;
  }

  .trainers-cta-btn:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
    box-shadow: 0 0 0 1px var(--color-brand), 0 8px 24px rgba(232, 180, 0, 0.15);
  }

  /* ── Responsive ───────────────────────────────── */
  @media (max-width: 767px) {
    .trainers-grid {
      grid-template-columns: 1fr;
      max-width: 400px;
    }

    .trainer-name {
      font-size: 1.3rem;
    }
  }
</style>
