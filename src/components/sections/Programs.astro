    title: 'Strength Training',
    description:
      'The best strength training in Gomti Nagar. Build raw power with our scientifically designed lifting protocols.',
    benefits: ['Linear Progression', 'Compound Movements', 'Hypertrophy Focus'],
    icon: 'dumbbell',
  },
  {
    id: 'weight-loss',
    title: 'Weight Loss Program',
    description:
      'Effective weight loss programs in Lucknow. High-intensity metabolic conditioning to burn fat fast.',
    benefits: ['HIIT Circuits', 'Nutritional Guidance', 'Metabolic Boost'],
    icon: 'flame',
  },
  {
    id: 'personal-training',
    title: 'Personal Training',
    description:
      'Certified personal trainers in Gomti Nagar. One-on-one coaching tailored specifically to your goals.',
    benefits: ['Custom Plans', 'Form Correction', 'Accountability'],
    icon: 'person',
  },
  {
    id: 'zumba-yoga',
    title: 'Zumba & Yoga',
    description:
      'Premium Zumba and Yoga classes in Lucknow. Improve flexibility and cardiovascular health.',
    benefits: ['Expert Instructors', 'Flexibility Focus', 'Stress Relief'],
    icon: 'activity',
  },
  {
    id: 'diet-nutrition',
    title: 'Diet & Nutrition',
    description:
      'Customized diet and nutrition plans in Gomti Nagar. Precision fueling strategies designed to complement your training.',
    benefits: ['Custom Meal Plans', 'Macro Tracking', 'Sustainable Habits'],
    icon: 'leaf',
  },
  {
    id: 'athlete-conditioning',
    title: 'Athlete Conditioning',
    description:
      'Top-tier athlete conditioning in Lucknow. Sport-specific training to enhance power, speed, and agility.',
    benefits: ['Explosive Power', 'Agility Drills', 'Injury Prevention'],
    icon: 'trophy',
  },
];

/* ── Inline SVG icon map ─────────────────────────────── */
