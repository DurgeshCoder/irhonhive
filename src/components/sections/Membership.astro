---
// Membership.astro — Ironhive Fitness Gym
// 3-plan pricing section

const plans = [
  {
    id: 'monthly',
    name: 'Monthly',
    currency: '₹',
    amount: '1,500',
    period: '/mo',
    desc: 'Standard monthly access to gym facilities.',
    features: [
      'Access to Gym Floor',
      'General Trainer Support',
      'Locker Access',
      'Strength + HIIT',
    ],
    cta: 'Join Monthly',
    ctaLink:
      'https://wa.me/918127171111?text=Hi%20Ironhive,%20I%27m%20interested%20in%20the%20Monthly%20membership%20plan.',
    highlighted: false,
  },
  {
    id: 'quarterly',
    name: 'Quarterly',
    currency: '₹',
    amount: '4,000',
    period: '/3mo',
    desc: 'Commit to 3 months and save big.',
    features: [
      'All Monthly Features',
      'Diet Plan & Nutrition',
      'Personal Coaching Support',
      'Zumba & Yoga Access',
    ],
    cta: 'Join Quarterly',
    ctaLink:
      'https://wa.me/918127171111?text=Hi%20Ironhive,%20I%27m%20interested%20in%20the%20Quarterly%20membership%20plan.',
    highlighted: true,
    badge: '★ Best Value',
  },
  {
    id: 'halfyearly',
    name: 'Half Yearly',
    currency: '₹',
    amount: '7,000',
    period: '/6mo',
    desc: 'Serious commitment for serious results.',
    features: [
      'All Quarterly Features',
      'Advanced Weight Training',
      'Special Batch Access',
      'Priority Support',
    ],
    cta: 'Join Half Yearly',
    ctaLink:
      'https://wa.me/918127171111?text=Hi%20Ironhive,%20I%27m%20interested%20in%20the%20Half%20Yearly%20membership%20plan.',
    highlighted: false,
  },
];
---

<section class="membership-section" id="membership" aria-label="Membership Plans">
  <!-- Background grid decoration -->
  <div class="membership-grid-bg" aria-hidden="true"></div>

  <div class="container">
    <!-- Section header -->
    <div class="section-header fade-in">
      <span class="section-label">Membership Plans</span>
      <h2 class="section-h2">
        Choose Your <span class="text-brand">Path</span>
      </h2>
      <p class="section-desc">
        Every body is different. Every goal is unique. Pick the plan that fits
        your journey — and let Ironhive do the rest.
      </p>
    </div>

    <!-- Info bar: hours + free trial -->
    <div class="membership-info-bar fade-in">
      <!-- Gym hours badge -->
      <div class="info-badge hours-badge" aria-label="Gym operating hours">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>5:30 AM – 11:30 AM &nbsp;|&nbsp; 4:00 PM – 10:00 PM</span>
      </div>

      <!-- Free trial animated pulse badge -->
      <div class="info-badge trial-badge" aria-label="Free trial available">
        <span class="pulse-dot" aria-hidden="true"></span>
        <span>Free Trial Available</span>
      </div>
    </div>

    <!-- Plans grid -->
    <div class="membership-plans fade-in" role="list" aria-label="Membership plan options">
      {
        plans.map((plan) => (
          <div
            class:list={['plan-card', { highlighted: plan.highlighted }]}
            role="listitem"
            aria-label={`${plan.name} membership plan`}
          >
            {/* Best Value badge */}
            {plan.badge && (
              <div class="plan-badge" aria-label="Best value plan">
                {plan.badge}
              </div>
            )}

            {/* Plan header */}
            <div class="plan-header">
              <div class="plan-name">{plan.name}</div>
              <div class="plan-price">
                <span class="plan-currency">{plan.currency}</span>
                <span class="plan-amount">{plan.amount}</span>
                <span class="plan-period">{plan.period}</span>
              </div>
              <p class="plan-desc">{plan.desc}</p>
            </div>

            {/* Feature list */}
            <ul class="plan-features" aria-label={`${plan.name} plan features`}>
              {plan.features.map((feature) => (
                <li class="plan-feature">
                  <svg
                    class="plan-feature-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            {/* CTA */}
            <div class="plan-cta">
              <a
                href={plan.ctaLink}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  plan.highlighted ? 'plan-cta-primary' : 'plan-cta-default',
                ]}
                aria-label={`${plan.cta} — opens WhatsApp`}
              >
                {plan.highlighted && (
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    style="margin-right:8px;flex-shrink:0"
                  >
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                  </svg>
                )}
                {plan.cta}
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Registration note -->
    <p class="membership-note fade-in" aria-label="Registration fee notice">
      * +₹300 one-time registration fee applies on all plans &nbsp;·&nbsp; All plans include full gym access
    </p>
  </div>
</section>

<style>
  /* ── Layout ─────────────────────────────────── */
  .membership-section {
    padding: var(--section-gap) 0;
    background: var(--color-bg);
    position: relative;
    overflow: hidden;
  }

  /* Subtle grid background */
  .membership-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(232, 180, 0, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(232, 180, 0, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  /* ── Section header ───────────────────────────── */
  .section-header {
    text-align: center;
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  .section-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand);
    background: rgba(232, 180, 0, 0.08);
    border: 1px solid rgba(232, 180, 0, 0.2);
    border-radius: 100px;
    padding: 6px 16px;
    margin-bottom: 20px;
  }

  .section-h2 {
    font-family: var(--font-headline);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--color-text);
    margin: 0 0 16px;
  }

  .section-desc {
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Info bar ─────────────────────────────────── */
  .membership-info-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: center;
    margin-bottom: clamp(40px, 5vw, 56px);
  }

  .info-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 10px 20px;
    border-radius: 100px;
  }

  .hours-badge {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .trial-badge {
    background: rgba(232, 180, 0, 0.1);
    border: 1px solid rgba(232, 180, 0, 0.25);
    color: var(--color-brand);
  }

  /* Animated pulse dot */
  .pulse-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--color-brand);
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
  }

  .pulse-dot::before {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background: rgba(232, 180, 0, 0.4);
    animation: pulsering 1.6s ease-out infinite;
  }

  @keyframes pulsering {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(2); opacity: 0; }
  }

  /* ── Plans grid ───────────────────────────────── */
  .membership-plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2vw, 24px);
    align-items: start;
  }

  /* ── Plan card ────────────────────────────────── */
  .plan-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 20px);
    padding: clamp(28px, 3.5vw, 40px);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    transition: all 0.25s ease;
  }

  .plan-card:hover {
    border-color: rgba(232, 180, 0, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
  }

  .plan-card.highlighted {
    border-color: var(--color-brand);
    box-shadow:
      0 0 0 1px var(--color-brand),
      0 20px 60px rgba(232, 180, 0, 0.15);
    transform: scale(1.04);
    background: var(--color-surface-2);
  }

  .plan-card.highlighted:hover {
    transform: scale(1.04) translateY(-4px);
  }

  /* Best Value badge */
  .plan-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-brand);
    color: #0d0d0d;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 16px;
    border-radius: 100px;
    white-space: nowrap;
    box-shadow: 0 4px 16px rgba(232, 180, 0, 0.35);
  }

  /* ── Plan header ──────────────────────────────── */
  .plan-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .plan-name {
    font-family: var(--font-headline);
    font-size: 1.4rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .plan-price {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    line-height: 1;
  }

  .plan-currency {
    font-family: var(--font-headline);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-brand);
    margin-top: 6px;
  }

  .plan-amount {
    font-family: var(--font-headline);
    font-size: clamp(3rem, 5vw, 4rem);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.03em;
  }

  .plan-period {
    font-size: 0.85rem;
    color: var(--color-muted);
    align-self: flex-end;
    margin-bottom: 6px;
    font-family: var(--font-mono);
  }

  .plan-desc {
    font-size: 0.88rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-top: 4px;
  }

  /* ── Features ─────────────────────────────────── */
  .plan-features {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .plan-feature {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .plan-feature-icon {
    color: var(--color-brand);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ── CTA ──────────────────────────────────────── */
  .plan-cta {
    margin-top: auto;
  }

  .plan-cta a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 52px;
    border-radius: 8px;
    font-family: var(--font-headline);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .plan-cta-default {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .plan-cta-default:hover {
    background: var(--color-surface-2);
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .plan-cta-primary {
    background: var(--color-brand);
    border: 1px solid var(--color-brand);
    color: #0d0d0d;
    box-shadow: 0 4px 20px rgba(232, 180, 0, 0.25);
  }

  .plan-cta-primary:hover {
    background: var(--color-brand-dark);
    box-shadow: 0 8px 32px rgba(232, 180, 0, 0.35);
  }

  /* ── Registration note ────────────────────────── */
  .membership-note {
    text-align: center;
    margin-top: clamp(24px, 3vw, 40px);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    opacity: 0.65;
  }

  /* ── Responsive ───────────────────────────────── */
  @media (max-width: 1023px) {
    .membership-plans {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin: 0 auto;
    }

    .plan-card.highlighted {
      transform: none;
    }

    .plan-card.highlighted:hover {
      transform: translateY(-4px);
    }
  }

  @media (max-width: 479px) {
    .membership-plans {
      max-width: 100%;
    }
  }
</style>
