---
const videos = [
  { id: 'TKbuZUOW8og', title: 'Train Insane' },
  { id: '1NjVm-01Wu4', title: 'No Excuses' },
  { id: '4I_R5k1-Wl8', title: 'Heavy Lifting' },
  { id: 'Om-fhgsX0d0', title: 'Hive Mentality' },
];

const youtubeChannel = 'https://www.youtube.com/@TheMuscleGameSK/shorts';
---

<section class="youtube-section" id="youtube" aria-labelledby="youtube-heading">
  <div class="container">
    <!-- Label with pulsing red dot -->
    <div class="youtube-label" aria-hidden="true">
      <span class="youtube-dot"></span>
      <span class="youtube-label-text">Trending Now</span>
    </div>

    <!-- Heading -->
    <h2 id="youtube-heading" class="youtube-h2">
      Watch The <span class="text-brand">Muscle Game</span>
    </h2>

    <!-- Description -->
    <p class="youtube-desc">
      Daily motivation, technique tips, and raw training footage straight from the floor.
    </p>

    <!-- Shorts grid -->
    <div class="youtube-grid">
      {videos.map(video => (
        <div class="youtube-short">
          <iframe
            src={`https://www.youtube.com/embed/${video.id}?autoplay=0&controls=1&rel=0`}
            title={video.title}
            loading="lazy"
            allowfullscreen
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          ></iframe>
        </div>
      ))}
    </div>

    <!-- Subscribe CTA -->
    <div class="youtube-cta">
      <a
        href={youtubeChannel}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-youtube"
        aria-label="Subscribe to Ironhive YouTube channel (opens in new tab)"
      >
        <!-- YouTube icon -->
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
        </svg>
        Subscribe to Channel
      </a>
    </div>
  </div>
</section>

<style>
  /* ── Section ── */
  .youtube-section {
    padding: var(--section-gap) 0;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  /* ── Live / trending label ── */
  .youtube-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .youtube-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #FF0000;
    box-shadow: 0 0 10px rgba(255, 0, 0, 0.6);
    animation: pulse-brand 1.5s infinite;
    flex-shrink: 0;
  }

  /* Fallback pulse if global pulse-brand not defined */
  @keyframes pulse-brand {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.6; transform: scale(1.35); }
  }

  .youtube-label-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #FF0000;
    font-weight: 700;
  }

  /* ── Heading ── */
  .youtube-h2 {
    font-family: var(--font-headline);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 0.9;
    text-align: center;
    margin-bottom: 12px;
  }

  /* ── Description ── */
  .youtube-desc {
    text-align: center;
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: var(--color-muted);
    max-width: 560px;
    margin: 0 auto clamp(40px, 5vw, 60px);
    line-height: 1.7;
  }

  /* ── Shorts grid ── */
  .youtube-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 1.5vw, 20px);
    margin-bottom: clamp(40px, 5vw, 60px);
  }

  /* ── Single short card ── */
  .youtube-short {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: border-color 0.3s ease;
  }
  .youtube-short:hover {
    border-color: rgba(255, 0, 0, 0.4);
  }
  .youtube-short iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* ── CTA ── */
  .youtube-cta {
    text-align: center;
  }

  .btn-youtube {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #FF0000;
    color: #ffffff;
    border: none;
    padding: 0 36px;
    height: 54px;
    border-radius: 8px;
    font-family: var(--font-headline);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 20px rgba(255, 0, 0, 0.25);
  }
  .btn-youtube:hover {
    background: #CC0000;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(255, 0, 0, 0.35);
  }
  .btn-youtube:active {
    transform: translateY(0);
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) {
    .youtube-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 599px) {
    .youtube-grid {
      grid-template-columns: 1fr;
    }
    .btn-youtube {
      width: 100%;
      justify-content: center;
    }
  }
</style>
