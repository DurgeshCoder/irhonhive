---
// Features.astro — Ironhive Fitness Gym
---

<section class="features-section" id="features" aria-label="Core training features">
  <div class="container">
    <div class="features-grid">

      <!-- Card 1: Advance Weight Training -->
      <article class="feature-card reveal">
        <div class="icon-box" aria-hidden="true">
          <!-- Dumbbell SVG -->
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 5v14" />
            <path d="M18 5v14" />
            <rect x="3" y="7" width="4" height="10" rx="1" />
            <rect x="17" y="7" width="4" height="10" rx="1" />
            <path d="M7 12h10" />
          </svg>
        </div>
        <h3 class="feature-title">Advance Weight Training</h3>
        <p class="feature-desc">
          Master your form with professional-grade equipment and expert guidance.
        </p>
      </article>

      <!-- Card 2: CrossFit & Cardio -->
      <article class="feature-card reveal reveal-delay-1">
        <div class="icon-box" aria-hidden="true">
          <!-- Flame SVG -->
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M8.5 14.5A5 5 0 0 0 17 9c0-3-2.5-5-2.5-5S13 6 11 7c-1.5 1-3.5 1-3.5 4 0 .5.1 1 .3 1.5" />
            <path d="M12 22c-4.4 0-8-3.6-8-8 0-3.3 2-6.2 5-7.5.4 1 1.3 1.8 2.3 2.1C12.8 9.4 14 11.1 14 13c0 1.7-1 3.3-2.5 4.2" />
            <path d="M12 22c1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3 1.3 3 3 3z" />
          </svg>
        </div>
        <h3 class="feature-title">CrossFit &amp; Cardio</h3>
        <p class="feature-desc">
          High-intensity functional training to boost your metabolic rate and endurance.
        </p>
      </article>

      <!-- Card 3: Personal Coaching -->
      <article class="feature-card reveal reveal-delay-2">
        <div class="icon-box" aria-hidden="true">
          <!-- Person SVG -->
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="7" r="4" />
            <path d="M5.5 21a8.38 8.38 0 0 1 13 0" />
          </svg>
        </div>
        <h3 class="feature-title">Personal Coaching</h3>
        <p class="feature-desc">
          Dedicated 1-on-1 attention to fast-track your fitness transformation.
        </p>
      </article>

      <!-- Card 4: Diet & Nutrition -->
      <article class="feature-card reveal reveal-delay-3">
        <div class="icon-box" aria-hidden="true">
          <!-- Leaf SVG -->
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z" />
            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
          </svg>
        </div>
        <h3 class="feature-title">Diet &amp; Nutrition</h3>
        <p class="feature-desc">
          Tailored meal plans and expert counseling to fuel your body correctly.
        </p>
      </article>

    </div>
  </div>
</section>

<style>
  /* ─── Section wrapper ─────────────────────────────────────── */
  .features-section {
    padding: 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  /* ─── Grid ────────────────────────────────────────────────── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  /* ─── Feature card ────────────────────────────────────────── */
  .feature-card {
    padding: clamp(32px, 4vw, 48px) clamp(24px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    border-right: 1px solid var(--color-border);
    transition: background 0.25s ease;
    position: relative;
    overflow: hidden;
    cursor: default;
  }

  .feature-card:last-child {
    border-right: none;
  }

  /* Bottom accent bar on hover */
  .feature-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .feature-card:hover::after {
    transform: scaleX(1);
  }

  .feature-card:hover {
    background: var(--color-surface-2);
  }

  /* Icon box transitions on hover */
  .feature-card:hover .icon-box {
    background: var(--color-brand);
    color: #0d0d0d;
    border-color: var(--color-brand);
  }

  /* ─── Icon box ────────────────────────────────────────────── */
  .icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: rgba(232, 180, 0, 0.08);
    border: 1px solid rgba(232, 180, 0, 0.2);
    color: var(--color-brand);
    flex-shrink: 0;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  /* ─── Card title ──────────────────────────────────────────── */
  .feature-title {
    font-family: var(--font-headline);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-text);
    letter-spacing: -0.01em;
    transition: color 0.2s;
    line-height: 1.1;
  }

  .feature-card:hover .feature-title {
    color: var(--color-brand);
  }

  /* ─── Card description ────────────────────────────────────── */
  .feature-desc {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  /* ─── Reveal animation (driven by global reveal observer) ─── */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: none;
  }

  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }

  /* ─── Responsive: tablet ──────────────────────────────────── */
  @media (max-width: 1023px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .feature-card:nth-child(2) {
      border-right: none;
    }

    .feature-card:nth-child(1),
    .feature-card:nth-child(2) {
      border-bottom: 1px solid var(--color-border);
    }

    .feature-card:nth-child(4) {
      border-right: none;
    }
  }

  /* ─── Responsive: mobile ──────────────────────────────────── */
  @media (max-width: 599px) {
    .features-grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      border-right: none !important;
      border-bottom: 1px solid var(--color-border);
    }

    .feature-card:last-child {
      border-bottom: none;
    }
  }
</style>

<script>
  // Reveal animation observer for feature cards
  const revealEls = document.querySelectorAll('.feature-card.reveal');
  if (revealEls.length > 0) {
    const revealObserver = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    revealEls.forEach(el => revealObserver.observe(el));
  }
</script>
