---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Weight Loss Program in Lucknow | Best Fat Loss Gym | Ironhive Gomti Nagar"
  description="Achieve rapid fat loss with our proven weight loss program at Ironhive Fitness, Gomti Nagar, Lucknow. HIIT training, personalized diet plans, and certified coaches to help you lose weight fast."
  canonical="https://ironhive.fitness/weight-loss-program-lucknow/"
  breadcrumbs={[{ name: 'Weight Loss Program Lucknow', url: 'https://ironhive.fitness/weight-loss-program-lucknow/' }]}
>
  <!-- Hero -->
  <section class="local-hero">
    <div class="container local-hero-container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Weight Loss Program</span>
      </nav>
      <div class="local-hero-content reveal">
        <h1 class="headline-lg">Weight Loss Program<br/>in Lucknow</h1>
        <h2 class="headline-sm text-brand mt-4">Shed Fat, Build Confidence</h2>
        <div class="local-hero-body">
          <p>Struggling to lose weight on your own? The best fat loss program in Gomti Nagar is here. At Ironhive Fitness, we combine science-backed HIIT training, strength circuits, and personalized nutrition to ignite your metabolism and torch body fat.</p>
          <p>Our weight loss gym in Lucknow doesn't rely on starvation diets or endless hours on the treadmill. We focus on building a strong, lean physique through functional movements that burn calories during and long after your workout.</p>
          <p>Join the hundreds of members who have successfully transformed their bodies with our dedicated fat loss program in Gomti Nagar. Let our certified coaches guide you every step of the way to ensure sustainable and rapid results.</p>
        </div>
        <div class="local-hero-cta">
          <a href="https://wa.me/918127171111?text=Hi%20Ironhive,%20I'm%20interested%20in%20the%20Weight%20Loss%20Program!" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">Start Your Journey Today</a>
        </div>
      </div>
    </div>
  </section>

  <!-- The Program -->
  <section class="section section-surface">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="headline-md">The Program</h2>
      </div>
      <div class="grid-3">
        <div class="card p-6 reveal">
          <div class="text-brand text-2xl mb-4">🔥</div>
          <h3 class="headline-sm mb-2">HIIT Circuits</h3>
          <p class="body-base">High-intensity interval training to maximize calorie burn in minimum time.</p>
        </div>
        <div class="card p-6 reveal reveal-delay-1">
          <div class="text-brand text-2xl mb-4">🥗</div>
          <h3 class="headline-sm mb-2">Nutritional Guidance</h3>
          <p class="body-base">Custom diet plans designed to support fat loss without sacrificing energy.</p>
        </div>
        <div class="card p-6 reveal reveal-delay-2">
          <div class="text-brand text-2xl mb-4">🏋️</div>
          <h3 class="headline-sm mb-2">Strength Training</h3>
          <p class="body-base">Build lean muscle to permanently increase your resting metabolic rate.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Success Stats -->
  <section class="section text-center">
    <div class="container">
      <h2 class="headline-md mb-6 reveal">Proven Results</h2>
      <div class="grid-3" style="max-width: 800px; margin: 0 auto;">
        <div class="reveal">
          <div class="text-brand" style="font-size: 3rem; font-family: var(--font-headline); font-weight: 900;">500+</div>
          <div class="label-text mt-2">Transformations</div>
        </div>
        <div class="reveal reveal-delay-1">
          <div class="text-brand" style="font-size: 3rem; font-family: var(--font-headline); font-weight: 900;">8-12kg</div>
          <div class="label-text mt-2">Avg Loss (3 Months)</div>
        </div>
        <div class="reveal reveal-delay-2">
          <div class="text-brand" style="font-size: 3rem; font-family: var(--font-headline); font-weight: 900;">95%</div>
          <div class="label-text mt-2">Member Retention</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section section-surface text-center">
    <div class="container" style="max-width: 600px;">
      <div class="reveal">
        <div class="text-brand mb-4" style="font-size: 2rem;">"</div>
        <p class="body-lg" style="font-style: italic; margin-bottom: 24px;">"Lost 15kg in 4 months. If you are looking for a gym near you in Lucknow that actually delivers results, Ironhive is the place to be."</p>
        <p class="headline-sm">— David K.</p>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .local-hero {
    padding: clamp(120px, 15vw, 160px) 0 clamp(48px, 6vw, 80px);
    background: var(--color-bg);
  }
  .local-hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 28px;
  }
  .breadcrumb a {
    color: var(--color-brand);
  }
  .local-hero-content {
    max-width: 800px;
  }
  .local-hero-body {
    margin: 24px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }
  .p-6 { padding: 24px; }
  .mb-2 { margin-bottom: 8px; }
  .mb-4 { margin-bottom: 16px; }
  .mb-6 { margin-bottom: 24px; }
  .mt-2 { margin-top: 8px; }
  .mt-4 { margin-top: 16px; }
  .text-2xl { font-size: 2rem; }
  .text-center { text-align: center; }
</style>
