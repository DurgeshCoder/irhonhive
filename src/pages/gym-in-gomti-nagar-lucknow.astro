---
import BaseLayout from '../layouts/BaseLayout.astro';
import Membership from '../components/sections/Membership.astro';
import FAQ from '../components/sections/FAQ.astro';
---

<BaseLayout
  title="Gym in Gomti Nagar Lucknow | Best Fitness Center Near Me | Ironhive"
  description="Looking for the best gym in Gomti Nagar Lucknow? Ironhive Fitness at Vastu Khand offers world-class equipment, certified trainers & affordable plans. Book your free trial today!"
  canonical="https://ironhive.fitness/gym-in-gomti-nagar-lucknow/"
  breadcrumbs={[{ name: 'Gym in Gomti Nagar Lucknow', url: 'https://ironhive.fitness/gym-in-gomti-nagar-lucknow/' }]}
>
  <!-- Hero -->
  <section class="local-hero">
    <div class="container local-hero-container">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Gym in Gomti Nagar Lucknow</span>
      </nav>
      <div class="local-hero-content reveal">
        <h1 class="headline-lg">Gym in Gomti Nagar Lucknow</h1>
        <h2 class="headline-sm text-brand">The #1 Rated Fitness Center Near You</h2>
        <div class="local-hero-body">
          <p>If you're searching for a "gym near me in Gomti Nagar" or the "best fitness center in Lucknow", your search ends at Ironhive Fitness Gym. Conveniently located in Vastu Khand, Gomti Nagar, we offer a world-class training facility designed for people who are serious about their fitness goals.</p>
          <p>Our gym provides state-of-the-art strength training equipment, a dedicated cardio and functional training zone, and an environment that breathes motivation. Whether your goal is to lose weight, build muscle, or improve your overall health, Ironhive Fitness is equipped to help you succeed.</p>
          <p>What makes us the best gym in Lucknow? It's our community and our expert personal trainers in Gomti Nagar. We don't just provide equipment; we provide the guidance, nutritional planning, and accountability you need. From high-intensity interval training (HIIT) to targeted personal coaching, we have comprehensive programs for every fitness level.</p>
        </div>
        <div class="local-hero-cta">
          <a href="https://wa.me/918127171111?text=Hi%20Ironhive,%20I'd%20like%20to%20book%20a%20free%20trial." class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">Book Free Trial</a>
          <a href="#membership" class="btn btn-outline btn-lg">View Membership Plans</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="features-section section-surface">
    <div class="container">
      <div class="section-header reveal">
        <span class="label-text">Why Choose Ironhive</span>
        <h2 class="headline-md">Your Ultimate Fitness Destination</h2>
      </div>
      <div class="grid-3">
        <div class="card p-6 text-center reveal">
          <div class="icon-box mx-auto mb-4">⭐</div>
          <h3 class="headline-sm mb-2">Premium Equipment</h3>
          <p class="body-base">State-of-the-art machines and free weights for optimal training.</p>
        </div>
        <div class="card p-6 text-center reveal reveal-delay-1">
          <div class="icon-box mx-auto mb-4">👨‍🏫</div>
          <h3 class="headline-sm mb-2">Certified Trainers</h3>
          <p class="body-base">Expert coaching from Sunil Kumar and Punit Awasthi.</p>
        </div>
        <div class="card p-6 text-center reveal reveal-delay-2">
          <div class="icon-box mx-auto mb-4">🕐</div>
          <h3 class="headline-sm mb-2">Flexible Timings</h3>
          <p class="body-base">5:30 AM - 11:30 AM & 4:00 PM - 10:00 PM. Open 7 days a week.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section class="location-section">
    <div class="container">
      <div class="grid-2 align-center">
        <div class="location-info reveal">
          <h2 class="headline-md mb-4">Our Location</h2>
          <p class="body-lg mb-6">Located in the heart of Gomti Nagar for your convenience.</p>
          <ul class="checklist mb-6">
            <li class="checklist-item">
              <span class="checklist-icon">📍</span>
              <strong>Address:</strong> 1/21, Vastu Khand, Gomti Nagar, Lucknow, UP 226010 (Near SPNA Sweets)
            </li>
            <li class="checklist-item">
              <span class="checklist-icon">📞</span>
              <strong>Phone:</strong> <a href="tel:+918127171111" class="text-brand">+91-8127171111</a>, <a href="tel:+917007552746" class="text-brand">+91-7007552746</a>
            </li>
          </ul>
        </div>
        <div class="location-map reveal reveal-delay-1">
          <div class="map-container">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4180.0234236504575!2d81.0258346!3d26.870332500000004!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x399be34da239a60d%3A0xb9265f196c7211c4!2sIronhive%20fitness!5e1!3m2!1sen!2sin!4v1766661640311!5m2!1sen!2sin"
              width="100%" height="300" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade"
              title="Ironhive Fitness Gym Location Map - Gomti Nagar Lucknow"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Simplified -->
  <section id="membership" class="pricing-section section-surface">
    <div class="container">
      <div class="section-header reveal">
        <h2 class="headline-md">Affordable Plans</h2>
        <p class="body-base">Choose a membership that fits your goals.</p>
      </div>
      <div class="grid-3">
        <div class="card p-6 reveal">
          <h3 class="headline-sm">Monthly</h3>
          <div class="text-brand text-2xl font-bold my-4">₹1,500</div>
          <a href="https://wa.me/918127171111" class="btn btn-outline w-full" target="_blank" rel="noopener noreferrer">Join Monthly</a>
        </div>
        <div class="card p-6 card-highlight reveal reveal-delay-1">
          <div class="badge mb-2">★ Best Value</div>
          <h3 class="headline-sm">Quarterly</h3>
          <div class="text-brand text-2xl font-bold my-4">₹4,000</div>
          <a href="https://wa.me/918127171111" class="btn btn-primary w-full" target="_blank" rel="noopener noreferrer">Join Quarterly</a>
        </div>
        <div class="card p-6 reveal reveal-delay-2">
          <h3 class="headline-sm">Half Yearly</h3>
          <div class="text-brand text-2xl font-bold my-4">₹7,000</div>
          <a href="https://wa.me/918127171111" class="btn btn-outline w-full" target="_blank" rel="noopener noreferrer">Join Half Yearly</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Component -->
  <FAQ />

  <!-- Final CTA -->
  <section class="final-cta text-center section">
    <div class="container">
      <div class="reveal">
        <h2 class="headline-md mb-6">Start Your Fitness Journey Today</h2>
        <a href="https://wa.me/918127171111" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">Join The Hive</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .local-hero {
    padding: clamp(120px, 15vw, 160px) 0 clamp(48px, 6vw, 80px);
    background: var(--color-bg);
  }
  .local-hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 28px;
  }
  .breadcrumb a {
    color: var(--color-brand);
  }
  .local-hero-content {
    max-width: 800px;
  }
  .local-hero-body {
    margin: 24px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.8;
  }
  .local-hero-cta {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .p-6 { padding: 24px; }
  .mb-2 { margin-bottom: 8px; }
  .mb-4 { margin-bottom: 16px; }
  .mb-6 { margin-bottom: 24px; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .text-center { text-align: center; }
  .font-bold { font-weight: bold; }
  .text-2xl { font-size: 2rem; font-family: var(--font-headline); }
  .align-center { align-items: center; }
  .location-section { padding: var(--section-gap) 0; }
  .pricing-section { padding: var(--section-gap) 0; }
</style>
