---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const breadcrumbs = [
  { name: 'Blog', url: 'https://ironhive.fitness/blog/' },
  { name: post.data.title, url: `https://ironhive.fitness/blog/${post.id}/` },
];
---

<BaseLayout
  title={`${post.data.title} | Ironhive Fitness Gym Lucknow`}
  description={post.data.description}
  canonical={`https://ironhive.fitness/blog/${post.id}/`}
  ogType="article"
  ogImage={post.data.image}
  breadcrumbs={breadcrumbs}
>
  <article class="blog-post">
    <div class="blog-post-hero">
      {post.data.image && (
        <img src={post.data.image} alt={post.data.imageAlt || post.data.title} class="blog-post-hero-img" />
      )}
      <div class="blog-post-hero-content container">
        <a href="/blog/" class="back-to-blog">&larr; Back to all articles</a>
        <div class="badge mb-4" style="background:var(--color-brand);color:#0D0D0D;border-color:var(--color-brand);">{post.data.category}</div>
        <h1 class="headline-lg" style="color: #fff; max-width: 900px;">{post.data.title}</h1>
        <div class="blog-meta mt-4" style="color: rgba(255,255,255,0.8);">
          <span class="blog-author" style="color: var(--color-brand);">{post.data.author}</span>
          <span class="blog-dot">&bull;</span>
          <span class="blog-date">{post.data.pubDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>
    
    <div class="prose">
      <Content />
    </div>

    <div class="blog-cta-box">
      <div class="blog-cta-inner">
        <h2 class="headline-sm mb-4">Ready to start your fitness journey?</h2>
        <p class="body-base mb-6">Join Ironhive Fitness Gym in Gomti Nagar today.</p>
        <a href="https://wa.me/918127171111?text=Hi%20Ironhive,%20I'm%20ready%20to%20start%20my%20fitness%20journey!" class="btn btn-primary btn-lg" target="_blank" rel="noopener noreferrer">Join The Hive</a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    background: var(--color-bg);
  }
  .blog-post-hero {
    position: relative;
    height: clamp(300px, 45vw, 520px);
    display: flex;
    align-items: flex-end;
    padding-bottom: 40px;
    overflow: hidden;
    margin-top: 0;
    padding-top: 80px;
  }
  .blog-post-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.4);
  }
  .blog-post-hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
  }
  .back-to-blog {
    display: inline-block;
    color: var(--color-brand);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    margin-bottom: 24px;
    transition: opacity 0.2s;
  }
  .back-to-blog:hover {
    opacity: 0.8;
  }
  .blog-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
  }
  
  .prose {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 80px) var(--container-padding);
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.85;
  }
  .prose :global(h2) {
    font-family: var(--font-headline);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 40px 0 16px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--color-brand);
  }
  .prose :global(h3) {
    font-family: var(--font-headline);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-text);
    margin: 28px 0 12px;
  }
  .prose :global(p) { margin-bottom: 18px; }
  .prose :global(ul), .prose :global(ol) {
    padding-left: 20px;
    margin-bottom: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .prose :global(li) { color: var(--color-text-secondary); }
  .prose :global(strong) { color: var(--color-text); font-weight: 600; }
  .prose :global(a) { color: var(--color-brand); }
  
  .blog-cta-box {
    max-width: 760px;
    margin: 0 auto 60px;
    padding: 0 var(--container-padding);
  }
  .blog-cta-inner {
    background: var(--color-surface);
    border: 1px solid var(--color-brand);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 4vw, 40px);
    text-align: center;
    box-shadow: 0 0 40px rgba(232,180,0,0.08);
  }
  
  .mb-4 { margin-bottom: 16px; display: inline-block; }
  .mb-6 { margin-bottom: 24px; }
  .mt-4 { margin-top: 16px; }
</style>
