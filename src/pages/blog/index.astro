---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Fitness Blog | Expert Tips & Guides — Ironhive Fitness Gym Lucknow"
  description="Expert fitness advice on weight loss, muscle gain, nutrition, and workout guides from Ironhive Fitness Gym, Gomti Nagar, Lucknow's top fitness center."
  canonical="https://ironhive.fitness/blog/"
  breadcrumbs={[{ name: 'Blog', url: 'https://ironhive.fitness/blog/' }]}
>
  <!-- Hero section for blog -->
  <section class="blog-hero">
    <div class="container">
      <span class="label-text text-brand mb-4">The Knowledge Base</span>
      <h1 class="headline-lg">Latest Articles</h1>
      <p class="body-lg" style="max-width: 600px; margin: 20px auto 0;">Expert advice on training, nutrition, and lifestyle to help you conquer your goals.</p>
    </div>
  </section>

  <!-- Blog grid -->
  <section class="blog-listing-section">
    <div class="container">
      <div class="blog-listing-grid">
        {sortedPosts.map((post) => (
          <a href={`/blog/${post.id}/`} class="blog-card">
            <div class="blog-card-img">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.imageAlt || post.data.title} loading="lazy" />
              ) : (
                <div style="width: 100%; height: 100%; background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-2) 100%);"></div>
              )}
              <div style="position:absolute;top:16px;left:16px;">
                <span class="badge" style="background:var(--color-brand);color:#0D0D0D;border-color:var(--color-brand);">{post.data.category}</span>
              </div>
            </div>
            <div class="blog-card-body">
              <div class="blog-meta">
                <span class="blog-date">
                  {post.data.pubDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}
                </span>
                <span class="blog-dot">&bull;</span>
                <span class="blog-author">{post.data.author}</span>
              </div>
              <h3 class="blog-title">{post.data.title}</h3>
              <p class="blog-excerpt">{post.data.description}</p>
              <div class="blog-read-more">Read Full Article &rarr;</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-hero {
    padding: clamp(120px, 15vw, 180px) 0 clamp(60px, 8vw, 100px);
    background: var(--color-bg);
    text-align: center;
  }
  .blog-listing-section {
    padding: clamp(60px, 8vw, 100px) 0;
    background: var(--color-surface);
  }
  .blog-listing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.5vw, 28px);
  }
  .mb-4 { margin-bottom: 16px; display: block; }
  
  @media (max-width: 1023px) { .blog-listing-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 599px) { .blog-listing-grid { grid-template-columns: 1fr; } }
</style>
